{
  "name": "reddit-collector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n backend,inner,frontend -c blue,magenta,green \"npm:dev:backend\" \"npm:dev:inner\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .venv/bin/python -m app",
    "dev:inner": "cd backend && .venv/bin/python -m app.inner",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "cd backend && .venv/bin/python -m app",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && .venv/bin/pytest",
    "test:frontend": "npm test -w frontend",
    "test:live": "cd backend && .venv/bin/pytest -m live",
    "lint": "eslint . && cd backend && .venv/bin/ruff check . && .venv/bin/ruff format --check .",
    "format": "prettier --write frontend/src && cd backend && .venv/bin/ruff format ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
