# Every variable is optional. The defaults below are what the app uses when
# a variable is missing or empty. No Reddit account, key or secret is needed.

# Web service (Express): the address the browser and the Vite proxy use (local only by design)
PORT=3001
HOST=127.0.0.1
# REST route preset (only 'rest' exists)
API_ROUTES=rest
# How long the web service waits for the collector; above the collector's own 30 s limit
INNER_TIMEOUT_MS=35000

# Collector (Python inner server); the web service reads INNER_HOST/INNER_PORT too
INNER_HOST=127.0.0.1
INNER_PORT=3002
# Server implementation and worker threads (1-64); only 'threadpool' exists
SERVER=threadpool
SERVER_THREADS=8
# Resource-to-handler preset (only 'collector' exists)
INNER_ROUTES=collector

# live = scrape Reddit; fixture = offline sample data (stored in data/fixture.db)
COLLECTOR_MODE=live

# SQLite file. Defaults to ./data/collector.db (live) or ./data/fixture.db (fixture)
DB_PATH=

# Posts kept per collection (1-100)
MAX_POSTS=25

# Reuse a collection younger than this many seconds instead of calling Reddit (0 = off)
COLLECTION_TTL_SECONDS=60

# The UI shows a "stale" hint after this many seconds
STALE_AFTER_SECONDS=600

# Timeout for each HTTP request to Reddit, and the hard limit for a whole collection
REQUEST_TIMEOUT_MS=8000
COLLECTION_DEADLINE_MS=25000

# critical | error | warning | info | debug
LOG_LEVEL=info

# How the search term is turned into a subreddit name (backend/app/terms/presets.py).
# Only reddit-subreddit exists today. Use a separate DB_PATH per protocol.
TERM_PROTOCOL=reddit-subreddit
